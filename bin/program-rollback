#!/usr/bin/env bash
# Thin wrapper. All orchestration, argument parsing, the downgrade
# confirmation gate, the GitHub Release fetch + sha verification, and
# the delegation to scripts/src/deploy.ts live in
# scripts/src/rollback.ts. Pass --help for usage.
set -euo pipefail
REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")"/.. &>/dev/null && pwd)
export FLEX_INVOCATION_NAME="$(basename "$0")"
exec bun "$REPO_ROOT/scripts/src/rollback.ts" "$@"
