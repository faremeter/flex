#!/usr/bin/env opsh
# shellcheck shell=bash disable=SC2164
opsh::version::require v0.7.0
lib::import step-runner git command

# Rehearses the Ledger-as-operator release flow end-to-end on devnet:
#
#   1. Probes the on-device Solana pubkey from `$LEDGER_URL`.
#   2. Reads the second-member pubkey from `$PAYER_KEYPAIR_PATH`.
#   3. Generates a throwaway program keypair under tmp/rehearsal-...
#      and copies it to target/deploy/flex-keypair.json (the path
#      bin/program-initial-deploy reads).
#   4. Patches scripts/src/squads.config.ts's devnet block with the
#      two members and a 60-second time lock.
#   5. Patches scripts/src/initial-deploy.ts's getProgramId to return
#      the rehearsal program ID.
#   6. Runs anchor build to produce target/deploy/flex.so.
#   7. Runs bin/bootstrap-squads devnet with the Ledger as creator.
#   8. Patches the bootstrapped multisig address into squads.config.ts.
#   9. Runs bin/program-initial-deploy devnet with the Ledger as
#      operator payer; the operator drives the on-device confirmations
#      and the Phase 3 Squads UI approve+execute.
#
# Both patched files are tracked, and an EXIT trap restores them via
# `git checkout HEAD --` so a successful or interrupted run leaves the
# working tree clean.

REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")"/.. &>/dev/null && pwd)
LEDGER_URL="${LEDGER_URL:-usb://ledger?key=0}"
PAYER_KEYPAIR_PATH="${PAYER_KEYPAIR_PATH:-$HOME/sandbox/faremeter/keypairs/payer.json}"
REHEARSAL_DIR="$REPO_ROOT/tmp/rehearsal-ledger-devnet"
PROGRAM_KEYPAIR_DEST="$REPO_ROOT/target/deploy/flex-keypair.json"
INPUT_FIFO="$REHEARSAL_DIR/input-fifo"
INPUT_FIFO_HOLDER=""

PATCHED_FILES=(
	scripts/src/squads.config.ts
	scripts/src/initial-deploy.ts
	programs/flex/src/lib.rs
	Anchor.toml
)

cleanup_on_exit() {
	if [[ -n $INPUT_FIFO_HOLDER ]] && kill -0 "$INPUT_FIFO_HOLDER" 2>/dev/null; then
		kill "$INPUT_FIFO_HOLDER" 2>/dev/null || true
	fi
	if [[ -p $INPUT_FIFO ]]; then
		rm -f "$INPUT_FIFO"
	fi
	log::info "restoring patched files via 'git checkout HEAD --'"
	for relpath in "${PATCHED_FILES[@]}"; do
		git -C "$REPO_ROOT" checkout HEAD -- "$relpath" || true
	done
}

# `trap` fires once on shell exit regardless of how the script ended
# (clean success, log::fatal, ^C). The cleanup is idempotent.
trap cleanup_on_exit EXIT

step::10::check_prerequisites() {
	command::exists solana || log::fatal "solana CLI not installed"
	command::exists solana-keygen || log::fatal "solana-keygen not installed"
	command::exists anchor || log::fatal "anchor not installed"
	command::exists bun || log::fatal "bun not installed"
	command::exists perl || log::fatal "perl not installed (rehearsal patches use perl -0pe)"
	[[ -f $PAYER_KEYPAIR_PATH ]] || log::fatal "payer keypair not found at $PAYER_KEYPAIR_PATH"
	git -C "$REPO_ROOT" diff --quiet -- "${PATCHED_FILES[@]}" || log::fatal "${PATCHED_FILES[*]} have uncommitted changes; commit or stash before rehearsing (EXIT trap would clobber them)"
	mkdir -p "$REHEARSAL_DIR"
	mkdir -p "$REPO_ROOT/target/deploy"
	# Named FIFO that feeds prompts to bin/program-initial-deploy in
	# step 90. A separate `echo "value" > "$INPUT_FIFO"` command writes
	# each prompt response; a sleep-infinity holder keeps the FIFO open
	# for writing between writes (otherwise the reader sees EOF).
	[[ -p $INPUT_FIFO ]] || mkfifo "$INPUT_FIFO"
}

step::20::probe_ledger_address() {
	log::info "probing Ledger pubkey at $LEDGER_URL"
	log::info "  (Ledger must be connected, unlocked, on the Solana app,"
	log::info "   with blind signing enabled — otherwise this step errors out)"
	LEDGER_PUBKEY=$("$REPO_ROOT/bin/probe-ledger" "$LEDGER_URL")
	[[ -n $LEDGER_PUBKEY ]] || log::fatal "probe-ledger returned an empty pubkey"
	log::info "Ledger pubkey: $LEDGER_PUBKEY"
	printf '%s\n' "$LEDGER_PUBKEY" >"$REHEARSAL_DIR/ledger-pubkey"
}

step::30::derive_payer_pubkey() {
	PAYER_PUBKEY=$(solana-keygen pubkey "$PAYER_KEYPAIR_PATH")
	[[ -n $PAYER_PUBKEY ]] || log::fatal "solana-keygen pubkey returned empty for $PAYER_KEYPAIR_PATH"
	log::info "Payer pubkey:  $PAYER_PUBKEY"
	printf '%s\n' "$PAYER_PUBKEY" >"$REHEARSAL_DIR/payer-pubkey"
}

step::40::generate_program_keypair() {
	PROGRAM_KEYPAIR_PATH="$REHEARSAL_DIR/program-keypair.json"
	if [[ -f $PROGRAM_KEYPAIR_PATH ]]; then
		log::info "reusing rehearsal program keypair at $PROGRAM_KEYPAIR_PATH"
	else
		solana-keygen new --no-bip39-passphrase --silent -o "$PROGRAM_KEYPAIR_PATH"
	fi
	PROGRAM_ID=$(solana-keygen pubkey "$PROGRAM_KEYPAIR_PATH")
	log::info "Rehearsal program ID: $PROGRAM_ID"

	# bin/program-initial-deploy reads target/deploy/flex-keypair.json
	# directly. Copy the rehearsal keypair into that location.
	cp "$PROGRAM_KEYPAIR_PATH" "$PROGRAM_KEYPAIR_DEST"
}

step::50::patch_squads_config() {
	log::info "patching scripts/src/squads.config.ts devnet block (2-of-2, 60s timeLock)"
	# Replace the devnet { ... } block with the rehearsal members and
	# time lock. The multisig field stays at PLACEHOLDER_MULTISIG until
	# step 80, after bin/bootstrap-squads prints the real address.
	LEDGER_PUBKEY="$LEDGER_PUBKEY" PAYER_PUBKEY="$PAYER_PUBKEY" \
		perl -i -0pe '
		my $ledger = $ENV{LEDGER_PUBKEY};
		my $payer = $ENV{PAYER_PUBKEY};
		my $block = sprintf(qq|  devnet: {\n    multisig: PLACEHOLDER_MULTISIG,\n    members: [\n      new PublicKey("%s"),\n      new PublicKey("%s"),\n    ],\n    threshold: 2,\n    vaultIndex: 0,\n    verifyMode: "batched",\n    timeLock: 60,\n  },|, $ledger, $payer);
		s{  devnet: \{.*?^  \},}{$block}sm;
		' "$REPO_ROOT/scripts/src/squads.config.ts"
}

step::60::patch_initial_deploy_program_id() {
	log::info "patching scripts/src/initial-deploy.ts getProgramId to return $PROGRAM_ID"
	PROGRAM_ID="$PROGRAM_ID" perl -i -0pe '
		my $id = $ENV{PROGRAM_ID};
		s{function getProgramId\(\): PublicKey \{\n  return new PublicKey\(FLEX_PROGRAM_ADDRESS\);\n\}}{function getProgramId(): PublicKey {\n  return new PublicKey("$id");\n}}s;
		' "$REPO_ROOT/scripts/src/initial-deploy.ts"
}

step::65::patch_declare_id() {
	log::info "patching programs/flex/src/lib.rs declare_id! to $PROGRAM_ID"
	PROGRAM_ID="$PROGRAM_ID" perl -i -pe '
		my $id = $ENV{PROGRAM_ID};
		s{declare_id!\("[^"]+"\);}{declare_id!\("$id"\);};
		' "$REPO_ROOT/programs/flex/src/lib.rs"
	log::info "patching Anchor.toml [programs.*] entries to $PROGRAM_ID"
	PROGRAM_ID="$PROGRAM_ID" perl -i -pe '
		my $id = $ENV{PROGRAM_ID};
		s{^flex = "[^"]+"$}{flex = "$id"};
		' "$REPO_ROOT/Anchor.toml"
}

step::70::build_program() {
	log::info "building flex.so via 'anchor build' (declare_id! is now $PROGRAM_ID)"
	(cd "$REPO_ROOT" && anchor build) || log::fatal "anchor build failed"
}

# Phase 1 of bin/program-initial-deploy spends ProgramData rent
# (program_size * multiplier + ~45 bytes overhead). Phase 3 spends an
# upgrade-buffer rent (program_size + ~37 bytes overhead). Both come
# from the payer. The rehearsal previously assumed the payer was "big
# enough"; on a 485 KB program with the default 2.0x multiplier it
# needs ~10.2 SOL up-front, and a half-funded payer fails Phase 3 after
# Phase 1 already locked the ProgramData rent behind the multisig.
# Compute exact requirements via `solana rent` and fail loudly if the
# payer is short, so the operator can top up before any value moves.
step::75::ensure_payer_funded() {
	local so_path="$REPO_ROOT/target/deploy/flex.so"
	[[ -f $so_path ]] || log::fatal "flex.so missing at $so_path (step::70 should have produced it)"
	local program_size
	program_size=$(wc -c <"$so_path" | tr -d ' ')
	[[ -n $program_size && $program_size -gt 0 ]] || log::fatal "could not determine flex.so size"

	local multiplier="${FLEX_INITIAL_DEPLOY_MAX_LEN_MULTIPLIER:-2.0}"
	# Match initial-deploy.ts's Math.ceil(programSize * multiplier).
	local max_len
	max_len=$(awk -v s="$program_size" -v m="$multiplier" 'BEGIN { printf "%d", ((s*m)==int(s*m)) ? s*m : int(s*m)+1 }')

	# UpgradeableLoaderState::ProgramData header is 45 bytes;
	# UpgradeableLoaderState::Buffer header is 37 bytes. Query
	# `solana rent` for the authoritative cluster-side rent calc rather
	# than reimplementing the formula here.
	local pd_size=$((max_len + 45))
	local buf_size=$((program_size + 37))
	local rpc_url="${DEVNET_RPC_URL:-https://api.devnet.solana.com}"
	local pd_rent buf_rent
	pd_rent=$(solana rent "$pd_size" --url "$rpc_url" 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
	buf_rent=$(solana rent "$buf_size" --url "$rpc_url" 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
	[[ -n $pd_rent && -n $buf_rent ]] || log::fatal "failed to query solana rent for $rpc_url"

	# Slop covers tx fees + set-buffer-authority + set-upgrade-authority
	# + a small margin for unrelated CLI invocations. 0.1 SOL is empirically
	# generous on devnet.
	local slop="0.1"
	local required
	required=$(awk -v a="$pd_rent" -v b="$buf_rent" -v s="$slop" 'BEGIN { printf "%.4f", a+b+s }')

	local payer_balance
	payer_balance=$(solana balance "$PAYER_PUBKEY" --url "$rpc_url" 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
	[[ -n $payer_balance ]] || log::fatal "could not read payer balance for $PAYER_PUBKEY"

	log::info "payer SOL budget:"
	log::info "  Phase 1 ProgramData rent (size=$pd_size, mult=$multiplier): $pd_rent SOL"
	log::info "  Phase 3 buffer rent      (size=$buf_size):                  $buf_rent SOL"
	log::info "  Tx-fee + authority-swap slop:                                $slop SOL"
	log::info "  Required total: $required SOL"
	log::info "  Payer balance:  $payer_balance SOL ($PAYER_PUBKEY)"

	local short
	short=$(awk -v r="$required" -v p="$payer_balance" 'BEGIN { d=r-p; printf "%.4f", (d>0)?d:0 }')
	if awk -v p="$payer_balance" -v r="$required" 'BEGIN { exit (p+0 >= r+0) ? 0 : 1 }'; then
		log::info "payer funding OK"
	else
		log::fatal "payer is short $short SOL; fund $PAYER_PUBKEY to >= $required SOL before retrying (e.g. 'solana transfer --from $LEDGER_URL --allow-unfunded-recipient $PAYER_PUBKEY $short --url $rpc_url')"
	fi
}

step::80::bootstrap_multisig() {
	if [[ -f $REHEARSAL_DIR/multisig ]]; then
		MULTISIG=$(cat "$REHEARSAL_DIR/multisig")
		log::info "reusing prior rehearsal multisig: $MULTISIG"
	else
		log::info ""
		log::info "Bootstrapping Squads multisig on devnet."
		log::info "The Ledger will be asked to sign the multisig-create transaction."
		log::info ""
		local output
		# bin/bootstrap-squads prints both human-readable logs to stderr
		# (via @faremeter/logs) and MULTISIG_ADDRESS=... / VAULT_PDA=...
		# to stdout. Capture stdout, tee stderr to the operator.
		output=$(CREATOR_KEYPAIR_PATH="$LEDGER_URL" \
			"$REPO_ROOT/bin/bootstrap-squads" devnet 2>&1 | tee /dev/stderr) \
			|| log::fatal "bin/bootstrap-squads devnet exited non-zero"
		MULTISIG=$(printf '%s\n' "$output" | grep '^MULTISIG_ADDRESS=' | cut -d= -f2)
		[[ -n $MULTISIG ]] || log::fatal "failed to parse MULTISIG_ADDRESS from bootstrap output"
		printf '%s\n' "$MULTISIG" >"$REHEARSAL_DIR/multisig"
		log::info "multisig bootstrapped: $MULTISIG"
	fi

	log::info "patching squads.config.ts with bootstrapped multisig"
	# Slurp mode + non-global s/// matches the first occurrence only —
	# the devnet block — leaving mainnet's PLACEHOLDER_MULTISIG alone.
	MULTISIG="$MULTISIG" perl -i -0pe '
		my $m = $ENV{MULTISIG};
		s{multisig: PLACEHOLDER_MULTISIG,}{multisig: new PublicKey\("$m"\),};
		' "$REPO_ROOT/scripts/src/squads.config.ts"
}

step::90::initial_deploy() {
	log::info ""
	log::info "running bin/program-initial-deploy devnet — payer signs all CLI shellouts;"
	log::info "the Ledger only signs the Phase 3 Squads approve vote (driven below)."
	log::info ""

	# A holder process keeps the FIFO open for writing so individual
	# `echo "value" > "$INPUT_FIFO"` writes don't deliver EOF to the
	# reader between prompts. The holder is killed by the EXIT trap.
	# `tail -f /dev/null` blocks forever portably; macOS's `sleep`
	# doesn't accept `infinity` so don't use that.
	tail -f /dev/null >"$INPUT_FIFO" &
	INPUT_FIFO_HOLDER=$!

	local deploy_log="$REHEARSAL_DIR/initial-deploy.log"
	rm -f "$deploy_log"
	OPERATOR_PAYER_KEYPAIR="$PAYER_KEYPAIR_PATH" \
		"$REPO_ROOT/bin/program-initial-deploy" devnet \
		<"$INPUT_FIFO" >"$deploy_log" 2>&1 &
	local deploy_pid=$!

	# Phase 2 prompts the operator to re-type the vault PDA. The same
	# vault PDA is printed on its own line ("vault pda:  XXX") at the
	# top of cmdRun's preflight. Wait for both the print and the prompt
	# to land, then write the value to the FIFO.
	log::info "waiting for Phase 2 vault-PDA prompt..."
	local vault_pda=""
	# Use a deadline-driven while loop with explicit iteration logging
	# every 30s; `for _ in $(seq ...)` interacted badly with opsh's
	# set -e and was running zero iterations.
	local deadline=$(($(date +%s) + 1800))
	local last_log=$(date +%s)
	while (( $(date +%s) < deadline )); do
		vault_pda=$(grep -oE 'vault pda:[[:space:]]+[A-HJ-NP-Za-km-z1-9]{32,44}' "$deploy_log" 2>/dev/null | tail -1 | awk '{print $NF}' || true)
		if [[ -n $vault_pda ]] && grep -q "retype the vault PDA exactly to proceed" "$deploy_log" 2>/dev/null; then
			break
		fi
		if (( $(date +%s) - last_log >= 30 )); then
			log::info "still waiting for Phase 2 prompt ($(date -u +%H:%M:%SZ))"
			last_log=$(date +%s)
		fi
		sleep 2
	done
	[[ -n $vault_pda ]] || log::fatal "vault PDA never printed; see $deploy_log"
	log::info "feeding vault PDA ($vault_pda) to FIFO"
	printf '%s\n' "$vault_pda" >"$INPUT_FIFO"

	# Phase 3 builds the upgrade-liveness proposal (payer-signed) and
	# prints proposal coordinates + state file. Parse transaction index
	# out of the state file, drive Ledger approve + payer approve +
	# payer execute, then feed 'executed' to unblock the inner prompt.
	log::info "waiting for Phase 3 proposal + state file..."
	local state_file=""
	deadline=$(($(date +%s) + 120))
	while (( $(date +%s) < deadline )); do
		state_file=$(grep -oE 'state file:[[:space:]]+[^[:space:]]+' "$deploy_log" 2>/dev/null | tail -1 | awk '{print $NF}' || true)
		[[ -n $state_file ]] && break
		sleep 1
	done
	[[ -n $state_file ]] || log::fatal "state file path not in $deploy_log"

	local upgrade_tx_index=""
	deadline=$(($(date +%s) + 1800))
	last_log=$(date +%s)
	while (( $(date +%s) < deadline )); do
		if [[ -f $state_file ]]; then
			upgrade_tx_index=$(jq -r '.transaction_index // empty' "$state_file" 2>/dev/null || true)
		fi
		if [[ -n $upgrade_tx_index ]] && grep -q "type 'executed' once the Squads UI" "$deploy_log" 2>/dev/null; then
			break
		fi
		if (( $(date +%s) - last_log >= 30 )); then
			log::info "still waiting for Phase 3 proposal ($(date -u +%H:%M:%SZ))"
			last_log=$(date +%s)
		fi
		sleep 2
	done
	[[ -n $upgrade_tx_index ]] || log::fatal "Phase 3 proposal transaction_index missing from $state_file"
	log::info "Phase 3 upgrade proposal tx-index: $upgrade_tx_index"

	drive_squads_proposal "$upgrade_tx_index" "Phase 3 upgrade"

	log::info "feeding 'executed' to FIFO"
	printf '%s\n' "executed" >"$INPUT_FIFO"

	# Phase 4 prints the key-destruction reminder and prompts 'read'.
	log::info "waiting for Phase 4 key-destruction acknowledgement..."
	deadline=$(($(date +%s) + 600))
	while (( $(date +%s) < deadline )); do
		if grep -q "type 'read' to confirm" "$deploy_log" 2>/dev/null; then
			break
		fi
		sleep 2
	done
	log::info "feeding 'read' to FIFO"
	printf '%s\n' "read" >"$INPUT_FIFO"

	wait "$deploy_pid" || log::fatal "bin/program-initial-deploy exited non-zero; see $deploy_log"
	log::info "initial deploy + liveness test complete"
}

step::95::smoke_test_on_chain() {
	log::info ""
	log::info "Smoke-testing the deployed rehearsal program on devnet."
	log::info "  The Ledger is the escrow owner + fee payer (no airdrop needed),"
	log::info "  calls create_escrow + close_escrow, asserts the on-chain state."
	log::info ""
	REHEARSAL_PROGRAM_ID="$PROGRAM_ID" \
		LEDGER_URL="$LEDGER_URL" \
		"$REPO_ROOT/bin/rehearsal-smoke-test" \
		|| log::fatal "smoke test failed; the program is deployed but did not respond as expected"
}

# Helper: drive a Squads proposal through approve+execute when both
# members are scripted (Ledger via $LEDGER_URL, payer via file).
# Approves under both keys, sleeps 65s past the 60s time lock, then
# executes via the payer (no Ledger prompt for execute).
drive_squads_proposal() {
	local tx_index="$1"
	local label="$2"
	log::info "approving $label proposal as Ledger (tx-index $tx_index)..."
	OPERATOR_PAYER_KEYPAIR="$LEDGER_URL" \
		"$REPO_ROOT/bin/program-squads-approve" devnet "$MULTISIG" "$tx_index" \
		|| log::fatal "Ledger approve failed for $label"
	log::info "approving $label proposal as payer..."
	OPERATOR_PAYER_KEYPAIR="$PAYER_KEYPAIR_PATH" \
		"$REPO_ROOT/bin/program-squads-approve" devnet "$MULTISIG" "$tx_index" \
		|| log::fatal "payer approve failed for $label"
	log::info "waiting 65s for the 60s time lock to elapse..."
	sleep 65
	log::info "executing $label proposal via payer..."
	OPERATOR_PAYER_KEYPAIR="$PAYER_KEYPAIR_PATH" \
		"$REPO_ROOT/bin/program-squads-execute" devnet "$MULTISIG" "$tx_index" \
		|| log::fatal "payer execute failed for $label"
}

step::96::close_program_data() {
	log::info ""
	log::info "Closing ProgramData to reclaim its rent into the vault PDA."
	log::info ""

	local close_log="$REHEARSAL_DIR/close.log"
	rm -f "$close_log"
	# bin/program-close composes the proposal (Ledger signs the
	# proposal-create tx), then prompts 'closed' once the multisig has
	# approved+executed the close. We launch it in the background so we
	# can drive the approve+execute via separate bin scripts.
	OPERATOR_PAYER_KEYPAIR="$LEDGER_URL" \
		"$REPO_ROOT/bin/program-close" devnet --i-want-to-close-this-program \
		<"$INPUT_FIFO" >"$close_log" 2>&1 &
	local close_pid=$!

	# Wait for the proposal-create tx to land and the script to print
	# `RETIRE: tx index:        N`. Time out after 5 minutes (Ledger
	# proposal-create may take a while with the user verifying the
	# blind-sign hash, but 5min covers the slow case).
	local close_tx_index=""
	local close_deadline=$(($(date +%s) + 300))
	while (( $(date +%s) < close_deadline )); do
		close_tx_index=$(grep -oE 'tx index:[[:space:]]+[0-9]+' "$close_log" 2>/dev/null | tail -1 | grep -oE '[0-9]+$' || true)
		[[ -n $close_tx_index ]] && break
		sleep 2
	done
	[[ -n $close_tx_index ]] || log::fatal "could not parse close proposal tx-index from $close_log within 300s"
	log::info "close proposal tx-index: $close_tx_index"

	drive_squads_proposal "$close_tx_index" "close"

	# Feed 'closed' to the FIFO so program-close's polling continues
	# past its operator confirmation prompt.
	printf '%s\n' "closed" >"$INPUT_FIFO"

	wait "$close_pid" || log::fatal "bin/program-close exited non-zero; see $close_log"
	log::info "ProgramData closed; rent moved to vault PDA $(jq -r '.vault_pda // empty' "$REHEARSAL_DIR"/multisig 2>/dev/null || echo '(see state file)')"
}

step::97::drain_vault() {
	log::info ""
	log::info "Draining vault PDA balance back to the Ledger."
	log::info ""

	local drain_log="$REHEARSAL_DIR/drain.log"
	rm -f "$drain_log"
	# bin/program-vault-drain composes the proposal (Ledger signs the
	# proposal-create tx) and exits. The drain itself happens when the
	# multisig executes the proposal; we drive that next.
	OPERATOR_PAYER_KEYPAIR="$LEDGER_URL" \
		"$REPO_ROOT/bin/program-vault-drain" devnet --recipient "$LEDGER_PUBKEY" \
		>"$drain_log" 2>&1 \
		|| log::fatal "bin/program-vault-drain failed; see $drain_log"

	# program-vault-drain emits a single JSON line on stdout with
	# {"transactionIndex":"N",...}. Parse it.
	local drain_tx_index
	drain_tx_index=$(grep -oE '"transactionIndex":"[0-9]+"' "$drain_log" | tail -1 | grep -oE '[0-9]+' || true)
	[[ -n $drain_tx_index ]] || log::fatal "failed to parse drain proposal tx-index from $drain_log"
	log::info "drain proposal tx-index: $drain_tx_index"

	drive_squads_proposal "$drain_tx_index" "drain"

	log::info "vault drained; balance returned to Ledger $LEDGER_PUBKEY"
}

step::99::summary() {
	local ledger_balance
	ledger_balance=$(solana balance "$LEDGER_PUBKEY" --url https://api.devnet.solana.com 2>/dev/null || echo "(unknown)")
	log::info ""
	log::info "================ Rehearsal complete ================"
	log::info "  Program ID: $PROGRAM_ID"
	log::info "  Multisig:   $(cat "$REHEARSAL_DIR/multisig")"
	log::info "  Time lock:  60 seconds"
	log::info "  Members:    Ledger ($LEDGER_PUBKEY)"
	log::info "              Payer  ($PAYER_PUBKEY)"
	log::info "  Threshold:  2 of 2"
	log::info ""
	log::info "  Ledger balance now: $ledger_balance"
	log::info ""
	log::info "Artifacts in $REHEARSAL_DIR/"
	log::info "Program keypair at $PROGRAM_KEYPAIR_DEST is the rehearsal throwaway."
	log::info "===================================================="
}

steps::run step
