#!/usr/bin/env bash
# Thin wrapper. All argument parsing, env validation, the
# SystemProgram.transfer composition, and the proposal-creation
# sendAndConfirm call live in scripts/src/squads-cli.ts. The proposal
# still has to be approved and executed via program-squads-approve
# and program-squads-execute. Pass --help for usage.
set -euo pipefail
REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")"/.. &>/dev/null && pwd)
export FLEX_INVOCATION_NAME="$(basename "$0")"
exec bun "$REPO_ROOT/scripts/src/squads-cli.ts" vault-drain "$@"
