#!/usr/bin/env bash
# Thin wrapper. All orchestration, argument parsing, state-file
# management, interactive prompts, and shell-outs to the `solana`,
# `solana-verify`, `gh`, and `gpg` CLIs live in scripts/src/deploy.ts.
# Pass --help for usage.
set -euo pipefail
REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")"/.. &>/dev/null && pwd)
export FLEX_INVOCATION_NAME="$(basename "$0")"
exec bun "$REPO_ROOT/scripts/src/deploy.ts" "$@"
