#!/usr/bin/env bash
# Thin wrapper. All four-phase orchestration, argument parsing,
# environment validation, interactive prompts, and shell-outs to the
# `solana` CLI live in scripts/src/initial-deploy.ts. Pass --help for
# usage.
set -euo pipefail
REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")"/.. &>/dev/null && pwd)
export FLEX_INVOCATION_NAME="$(basename "$0")"
exec bun "$REPO_ROOT/scripts/src/initial-deploy.ts" "$@"
